# Copy to .env and fill in. NEVER commit .env.

# Cloud APIs — offline phase only (public legal corpus / synthetic data / judge).
# Online audit queries never leave the machine (privacy boundary): the local
# SLM below is never swapped for a cloud API. Only fill in the key(s) for the
# provider(s) you actually selected below.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
ALIBABA_API_KEY=sk-...

# Active retrieval strategy for the consumer:
# zero_shot | vector_rag | hybrid | light_rag | hippo_rag
ACTIVE_STRATEGY=hybrid

# Infrastructure (defaults match docker-compose.yml)
KAFKA_BOOTSTRAP=localhost:9092
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=compliance123
OLLAMA_HOST=http://localhost:11434

# Local models (online audit path)
SLM_MODEL=llama3.1:8b-instruct-q4_K_M
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Offline cloud models. PROVIDER is one of: openai | anthropic | alibaba
# (see inference-service/common/llm_clients.py to add another). MODEL is
# whatever that provider calls it, e.g.:
#   openai:    gpt-4o
#   anthropic: claude-sonnet-5
#   alibaba:   qwen-max / qwen-plus / qwen-turbo
EXTRACTION_PROVIDER=openai
EXTRACTION_MODEL=gpt-4o
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-sonnet-5
QA_GENERATION_PROVIDER=openai
QA_GENERATION_MODEL=gpt-4o
