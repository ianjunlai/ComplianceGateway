# Copy to .env and fill in. NEVER commit .env.

# Cloud APIs — offline phase only (public legal corpus / synthetic data / judge).
# Online audit queries never leave the machine (privacy boundary): the local
# SLM below is never swapped for a cloud API. Only fill in the key(s) for the
# provider(s) you actually selected below.
ALIBABA_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Active retrieval strategy for the consumer:
# zero_shot | vector_rag | hybrid | light_rag | hippo_rag
ACTIVE_STRATEGY=hybrid

# Infrastructure (defaults match docker-compose.yml)
KAFKA_BOOTSTRAP=localhost:9092
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=compliance123
OLLAMA_HOST=http://localhost:11434

# Local models (online audit path). These are what the reported results used.
SLM_MODEL=qwen2.5:14b-instruct-q8_0
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# Ollama truncates silently from the end of the prompt, which is where attached
# provisions sit, so this must be set rather than left at the default.
SLM_NUM_CTX=16384

# Offline cloud models. PROVIDER is one of: openai | anthropic | alibaba
# (see inference-service/common/llm_clients.py to add another). MODEL is
# whatever that provider calls it. The values below are the ones the reported
# results were produced with; pin them, because floating aliases move.
EXTRACTION_PROVIDER=alibaba
EXTRACTION_MODEL=deepseek-v3.2
QA_GENERATION_PROVIDER=alibaba
QA_GENERATION_MODEL=qwen3.7-max
JUDGE_PROVIDER=alibaba
JUDGE_MODEL=MiniMax-M2.5

# Platform mechanisms, applied to every retrieval strategy alike.
ATTACH_CITATIONS=1
ATTACH_PER_CHUNK=2
ATTACH_CONTEXT_CAP=10
